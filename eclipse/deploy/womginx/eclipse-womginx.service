[Unit]
Description=Womginx proxy engine for Eclipse (private nginx instance)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/sbin/nginx -t -q -c /opt/womginx/nginx.eclipse.conf
ExecStart=/usr/sbin/nginx -c /opt/womginx/nginx.eclipse.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
