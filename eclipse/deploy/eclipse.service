[Unit]
Description=Eclipse (proxy engines, games, Jellyfin client, server shell)
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
User=eclipse
WorkingDirectory=/opt/eclipse
EnvironmentFile=/etc/eclipse.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
