[Unit]
Description=henws hub (Scramjet proxy, games, Jellyfin client)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=henws
WorkingDirectory=/opt/henws-hub
EnvironmentFile=/etc/henws-hub.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/henws-hub/data
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
